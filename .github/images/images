@dataclass
class Reference:
    repo: str
    path: str
    line: int
    found: str
    context: str = ""


def normalize(name: str) -> str:
    for prefix in ("docker.io/", "index.docker.io/"):
        if name.startswith(prefix):
            name = name[len(prefix) :]
    return name[len("library/") :] if name.startswith("library/") else name


def looks_like_image(s: str, known: set[str]) -> bool:
    """True for a string that is unmistakably an image reference: it parses, it
    carries a tag or digest, and its name is a registered image, first-party,
    or qualified by a registry host."""
    m = IMAGE_RE.match(s)
    if not m or not (m["tag"] or m["digest"]):
        return False
    name = normalize(m["name"])
    return name in known or name.startswith(FIRST_PARTY) or s.startswith(REGISTRY_HOSTS)


def substitute(value: str, env: dict[str, str]) -> str | None:
    """Expand $VAR, ${VAR} and ${VAR:-default}; None when a variable has no value."""
    missing = False

    def repl(m: re.Match[str]) -> str:
        nonlocal missing
        var, default = m["var"] or m["bare"], m["default"]
        if var in env:
            return env[var]
        if default is not None:
            return default
        missing = True
        return ""

    out = re.sub(r"\$(?:\{(?P<var>\w+)(?::?-(?P<default>[^}]*))?\}|(?P<bare>\w+))", repl, value)
    return None if missing else out


def yaml_docs(source: str, text: bool = False) -> list:
    """Every YAML document in a file (or in `source` itself when text=True) as
    JSON-compatible data, anchors and aliases resolved."""
    args = ["yq", "-o=json", "-I=0", "explode(.)"]
    p = subprocess.run(
        args + ([] if text else [source]), input=source if text else None, capture_output=True, text=True
    )
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip().splitlines()[-1] if p.stderr.strip() else "yq failed")
    docs = []
    decoder = json.JSONDecoder()
    buf = p.stdout.strip()
    while buf:
        doc, end = decoder.raw_decode(buf)
        docs.append(doc)
        buf = buf[end:].lstrip()
    return docs


def walk(node: object):
    """Yield every dict and string in a JSON-compatible tree."""
    stack = [node]
    while stack:
        n = stack.pop()
        if isinstance(n, dict):
            yield n
            stack.extend(n.values())
        elif isinstance(n, list):
            stack.extend(n)
        elif isinstance(n, str):
            yield n


def line_of(text: str, needle: str, after: int = 0) -> int:
    i = text.find(needle)
    return text.count("\n", 0, i) + 1 if i >= 0 else after


def repo_files(root: str) -> list[str]:
    p = subprocess.run(["git", "-C", root, "ls-files", "-z"], capture_output=True, text=True)
    if p.returncode == 0 and p.stdout:
        files = [f for f in p.stdout.split("\0") if f]
    else:
        files = []
        for d, dirs, names in os.walk(root):
            dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
            files += [os.path.relpath(os.path.join(d, n), root) for n in names]
    return sorted(f for f in files if not SKIP_DIRS.intersection(f.split("/")[:-1]))


def read_text(path: str) -> str | None:
    try:
        with open(path, "rb") as f:
            data = f.read(2_000_000)
    except OSError:
        return None
    if b"\0" in data[:8192]:
        return None
    return data.decode("utf-8", "replace")


def docker_cmd_image(args: str) -> str | None:
    """The image argument of a `docker run/pull/create` command line."""
    tokens = args.replace("\\", " ").split()
    i = 0
    while i < len(tokens):
        t = tokens[i]
        if t.startswith("-"):
            i += 1 if ("=" in t or t in DOCKER_BOOL_FLAGS) else 2
            continue
        return t.strip("'\"")
    return None


def scan_dockerfile(repo: str, rel: str, text: str) -> list[Reference]:
    out = []
    env: dict[str, str] = {}
    stages: set[str] = set()
    logical: list[tuple[int, str]] = []
    pending, start = "", 0
    for n, raw in enumerate(text.splitlines(), 1):
        if not pending:
            start = n
        stripped = raw.rstrip()
        if stripped.endswith("\\"):
            pending += stripped[:-1] + " "
            continue
        logical.append((start, pending + stripped))
        pending = ""
    for n, line in logical:
        words = line.split()
        if not words:
            continue
        inst = words[0].upper()
        if inst == "ARG" and len(words) > 1 and "=" in words[1]:
            k, v = words[1].split("=", 1)
            env.setdefault(k, v.strip("'\""))
        elif inst == "FROM":
            args = [w for w in words[1:] if not w.startswith("--")]
            if not args:
                continue
            image = substitute(args[0], env)
            if len(args) >= 3 and args[1].upper() == "AS":
                stages.add(args[2].lower())
            if image is None:
                out.append(Reference(repo, rel, n, args[0], "unresolved"))
            elif image.lower() not in stages and image != "scratch":
                out.append(Reference(repo, rel, n, image))
        elif inst in ("COPY", "RUN"):
            for m in re.finditer(r"--(?:from|mount=[^\s]*?\bfrom)=([^\s,]+)", line):
                src = m.group(1)
                if src.lower() in stages or src.isdigit():
                    continue
                image = substitute(src, env)
                out.append(Reference(repo, rel, n, image if image is not None else src, "" if image else "unresolved"))
    return out


def scan_compose(repo: str, rel: str, path: str, text: str) -> list[Reference]:
    out = []
    for doc in yaml_docs(path):
        for svc in ((doc or {}).get("services") or {}).values():
            if not isinstance(svc, dict) or "build" in svc or not isinstance(svc.get("image"), str):
                continue
            raw = svc["image"]
            image = substitute(raw, {})
            out.append(Reference(repo, rel, line_of(text, raw), image if image is not None else raw, "" if image else "unresolved"))
    return out


def scan_workflow(repo: str, rel: str, path: str, text: str) -> list[Reference]:
    out = []

    def add(raw: str) -> None:
        if "${{" in raw:
            out.append(Reference(repo, rel, line_of(text, raw), raw, "unresolved"))
        else:
            out.append(Reference(repo, rel, line_of(text, raw), raw))

    for doc in yaml_docs(path):
        doc = doc or {}
        for job in (doc.get("jobs") or {}).values():
            if not isinstance(job, dict):
                continue
            c = job.get("container")
            if isinstance(c, dict):
                c = c.get("image")
            if isinstance(c, str):
                add(c)
            for svc in (job.get("services") or {}).values():
                if isinstance(svc, dict) and isinstance(svc.get("image"), str):
                    add(svc["image"])
            for step in job.get("steps") or []:
                uses = step.get("uses") if isinstance(step, dict) else None
                if isinstance(uses, str) and uses.startswith("docker://"):
                    add(uses[len("docker://") :])
        image = ((doc.get("runs") or {}).get("image")) if isinstance(doc.get("runs"), dict) else None
        if isinstance(image, str) and image.startswith("docker://"):
            add(image[len("docker://") :])
    return out


def scan_yaml_lines(repo: str, rel: str, text: str) -> list[Reference]:
    out = []
    for n, line in enumerate(text.splitlines(), 1):
        m = re.match(r"""^\s*(?:-\s*)?image:\s*["']?([^"'\s#]+)""", line)
        if m and "{{" not in m.group(1) and not m.group(1).endswith(":"):
            out.append(Reference(repo, rel, n, m.group(1)))
    return out


def scan_code(repo: str, rel: str, text: str, known: set[str]) -> list[Reference]:
    out = []
    for n, line in enumerate(text.splitlines(), 1):
        for m in QUOTED_RE.finditer(line):
            if looks_like_image(m.group(2), known):
                out.append(Reference(repo, rel, n, m.group(2)))
    return out


def scan_commands(repo: str, rel: str, text: str, markdown: bool, known: set[str] = frozenset()) -> list[Reference]:
    """docker run/pull/create anywhere. In Markdown only fenced code counts, plus
    FROM in dockerfile fences and image: in YAML or unlabelled fences."""
    out = []
    fence: str | None = None
    for n, line in enumerate(text.splitlines(), 1):
        if markdown:
            stripped = line.strip()
            if stripped.startswith("```"):
                fence = None if fence is not None else stripped[3:].strip().lower()
                continue
            if fence is None:
                continue
        m = DOCKER_CMD_RE.search(line)
        if m:
            image = docker_cmd_image(m["args"])
            # A variable here is a freshly built image under test, never a pull.
            # A bare word (prose such as "docker run outside a fence") is not an
            # image: it needs a tag, a digest, a path or a registered name.
            im = IMAGE_RE.match(image) if image and "$" not in image else None
            if im and (im["tag"] or im["digest"] or "/" in image or normalize(im["name"]) in known):
                out.append(Reference(repo, rel, n, image))
        if not markdown:
            continue
        f = None
        if fence in ("dockerfile", "containerfile", "docker"):
            f = re.match(r"^\s*FROM\s+(?:--\S+\s+)*(\S+)", line, re.I)
        elif fence in ("", "yaml", "yml"):
            f = re.match(r"""^\s*(?:-\s*)?image:\s*["']?([^"'\s#]+)""", line)
        if f and "$" not in f.group(1) and "{{" not in f.group(1) and f.group(1) != "scratch":
            out.append(Reference(repo, rel, n, f.group(1)))
    return out


def chart_combos(chart: str) -> list[list[str]]:
    """Values layerings to render: values.yaml alone, with each environment, and
    with each environment x availability zone (Argo layers values, values-<env>,
    values-<az>, values-<env>-<az>). A superset of real deployments, so every
    image any deployment can render is seen."""
    names = sorted(
        f[len("values-") : -len(".yaml")]
        for f in os.listdir(chart)
        if f.startswith("values-") and f.endswith(".yaml")
    )
    azs = [n for n in names if AZ_RE.match(n)]
    pairs = [n for n in names if any(n.endswith("-" + az) and n != az for az in azs)]
    envs = sorted({n for n in names if n not in azs and n not in pairs} | {p[: -len(next(a for a in azs if p.endswith('-' + a))) - 1] for p in pairs})
    combos = [["values.yaml"]]
    for env in envs:
        base = ["values.yaml"] + ([f"values-{env}.yaml"] if env in names else [])
        combos.append(base)
        for az in azs:
            pair = [f"values-{env}-{az}.yaml"] if f"{env}-{az}" in names else []
            combos.append(base + [f"values-{az}.yaml"] + pair)
            combos.append(base + pair)
    seen, out = set(), []
    for c in combos:
        if tuple(c) not in seen:
            seen.add(tuple(c))
            out.append(c)
    return out


def scan_chart(repo: str, root: str, chart_rel: str, known: set[str]) -> tuple[list[Reference], list[Finding]]:
    chart = os.path.join(root, chart_rel)
    refs: dict[str, Reference] = {}
    findings: list[Finding] = []
    with open(os.path.join(chart, "Chart.yaml")) as f:
        if re.search(r"^dependencies:\s*\n\s+-", f.read(), re.M) and not os.path.isdir(os.path.join(chart, "charts")):
            subprocess.run(["helm", "dependency", "build", chart], capture_output=True)

    rendered = 0
    errors = []
    for combo in chart_combos(chart):
        args = ["helm", "template", "x", chart]
        for v in combo:
            args += ["-f", os.path.join(chart, v)]
        p = subprocess.run(args, capture_output=True, text=True)
        label = "+".join(c[len("values-") : -len(".yaml")] if c != "values.yaml" else "base" for c in combo)
        if p.returncode != 0:
            errors.append(f"{label}: {next((l for l in p.stderr.splitlines() if 'Error' in l), p.stderr.strip()[:200])}")
            continue
        rendered += 1
        for doc in yaml_docs(p.stdout, text=True):
            for node in walk(doc):
                image = None
                if isinstance(node, dict) and isinstance(node.get("image"), str):
                    image = node["image"]
                elif isinstance(node, str):
                    # Operators take the images they launch as flag values:
                    # --acme-http01-solver-image=quay.io/...:v1.20.2
                    candidate = node.rsplit("=", 1)[-1] if node.startswith("-") else node
                    if looks_like_image(candidate, known):
                        image = candidate
                if image and image not in refs:
                    refs[image] = Reference(repo, chart_rel, 0, image, f"rendered ({label})")

    if rendered == 0:
        findings.append(Finding("error", "render-failed", f"{repo}/{chart_rel}", "; ".join(errors[:3])))

    # Pins in values files that no combination renders (a disabled component)
    # still ship the moment someone enables them.
    for v in sorted(os.listdir(chart)):
        if not (v == "values.yaml" or (v.startswith("values-") and v.endswith(".yaml"))):
            continue
        path = os.path.join(chart, v)
        text = read_text(path) or ""
        for doc in yaml_docs(path):
            for node in walk(doc):
                if not isinstance(node, dict):
                    continue
                repo_name = node.get("repository") or node.get("repo")
                tag, digest = node.get("tag"), node.get("digest")
                if not isinstance(repo_name, str) or not repo_name or not isinstance(tag, str) or not tag:
                    continue
                if not IMAGE_RE.match(repo_name):
                    continue
                registry = node.get("registry")
                name = f"{registry}/{repo_name}" if isinstance(registry, str) and registry else repo_name
                image = f"{name}:{tag}" + (f"@{digest}" if isinstance(digest, str) and digest else "")
                if image not in refs:
                    refs[image] = Reference(repo, f"{chart_rel}/{v}", line_of(text, f"{tag}"), image, "values pin")
    return list(refs.values()), findings


def scan_repo(repo: str, root: str, known: set[str]) -> tuple[list[Reference], list[Finding]]:
    refs: list[Reference] = []
    findings: list[Finding] = []
    files = repo_files(root)
    charts = sorted({os.path.dirname(f) for f in files if os.path.basename(f) == "Chart.yaml"})
    if charts:
        if not shutil.which("helm"):
            findings.append(Finding("error", "tool-missing", repo, "helm is needed to render this repo's charts"))
        else:
            for chart in charts:
                r, f = scan_chart(repo, root, chart, known)
                refs += r
                findings += f
    in_chart = tuple(c + "/" for c in charts)

    for rel in files:
        path = os.path.join(root, rel)
        base = os.path.basename(rel)
        if DOCKERFILE_RE.search(rel):
            text = read_text(path)
            if text is not None:
                refs += scan_dockerfile(repo, rel, text)
            continue
        if rel.startswith(in_chart) and (base.startswith("values") or base == "Chart.yaml" or HELM_TEMPLATE_RE.search(rel[len(next(c for c in in_chart if rel.startswith(c))) :])):
            continue
        text = read_text(path)
        if text is None:
            continue
        if rel.endswith((".yaml", ".yml")):
            if COMPOSE_RE.search(rel):
                refs += scan_compose(repo, rel, path, text)
            elif WORKFLOW_RE.match(rel):
                refs += scan_workflow(repo, rel, path, text)
                refs += scan_commands(repo, rel, text, markdown=False, known=known)
            else:
                refs += scan_yaml_lines(repo, rel, text)
        elif rel.endswith(".md"):
            refs += scan_commands(repo, rel, text, markdown=True, known=known)
        elif rel.endswith(CODE_EXTS):
            refs += scan_code(repo, rel, text, known)
            refs += scan_commands(repo, rel, text, markdown=False, known=known)
        else:
            refs += scan_commands(repo, rel, text, markdown=False, known=known)
    return refs, findings


def judge(ref: Reference, entries: dict[tuple[str, str], Ref], names: set[str]) -> Finding | None:
    where = f"{ref.repo}/{ref.path}" + (f":{ref.line}" if ref.line else "") + (f" {ref.context}" if ref.context and ref.context != "unresolved" else "")
    if ref.context == "unresolved":
        return Finding("error", "unresolved", where, f"{ref.found}: a variable the check cannot resolve")
    if ref.found.endswith(":") and IMAGE_RE.match(ref.found[:-1]):
        return Finding("error", "no-tag", where, f"{ref.found}: empty tag; pin an exact tag and its digest")
    m = IMAGE_RE.match(ref.found)
    if not m:
        return Finding("error", "unresolved", where, f"{ref.found}: not an image reference the check can parse")
    name, tag, digest = normalize(m["name"]), m["tag"], m["digest"]
    if name.startswith(FIRST_PARTY):
        if not (tag and digest):
            return Finding("error", "first-party-unpinned", where, f"{ref.found}: first-party images pin sha-<commit>@sha256:<digest>")
        return None
    if not tag:
        entry = entries.get((name, ""))
        expected = f"expected {entry.raw}" if entry else "pin an exact tag and its digest"
        return Finding("error", "no-tag", where, f"{ref.found}: no tag; {expected}")
    entry = entries.get((name, flavor(tag)))
    if entry is None:
        hint = "; the registry has other flavors of it" if name in names else ""
        return Finding("error", "unregistered", where, f"{ref.found}: no registry entry{hint}")
    if (tag, digest) == (entry.tag, entry.digest):
        return None
    if tag == entry.tag and not digest:
        return Finding("error", "no-digest", where, f"{ref.found}: expected {entry.raw}")
    return Finding("error", "mismatch", where, f"{ref.found}: expected {entry.raw}")


def check(argv: list[str]) -> int:
    root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    config = os.path.join(root_dir, "images.config")
    as_json = False
    targets: list[str] = []
    it = iter(argv)
    for a in it:
        if a == "--config":
            config = next(it, "")
        elif a.startswith("--config="):
            config = a.split("=", 1)[1]
        elif a == "--json":
            as_json = True
        elif a.startswith("-"):
            print(f"images: unknown flag: {a}", file=sys.stderr)
            return 2
        else:
            targets.append(a)
    if not os.path.isfile(config):
        print(f"images: registry not found: {config}", file=sys.stderr)
        return 2

    allows: list[Allow] = []
    entries_list, findings = parse_config(config, allows)
    entries = {(normalize(r.name), flavor(r.tag)): r for r in entries_list}
    names = {normalize(r.name) for r in entries_list}
    if not shutil.which("yq"):
        findings.append(Finding("error", "tool-missing", "yq", "yq is needed to read YAML"))
        return report(findings, as_json)

    workspace = os.environ.get("QUALITHM_ROOT") or os.path.dirname(root_dir)
    whole_fleet = not targets
    if whole_fleet:
        with open(os.path.join(root_dir, "repos.json")) as f:
            targets = sorted(json.load(f)["repos"])
    repos = []
    for t in targets:
        path = t if os.path.isdir(t) and ("/" in t or t == ".") else os.path.join(workspace, t)
        if not os.path.isdir(path):
            if not whole_fleet:
                findings.append(Finding("error", "tool-missing", t, f"repo not found at {path}"))
            continue
        repos.append((os.path.basename(os.path.abspath(path)), path))

    for name, path in repos:
        try:
            refs, f = scan_repo(name, path, names)
        except RuntimeError as e:
            findings.append(Finding("error", "render-failed", name, str(e)))
            continue
        findings += f
        for ref in refs:
            finding = judge(ref, entries, names)
            if finding is None:
                continue
            allow = next(
                (a for a in allows if a.repo == ref.repo and fnmatch.fnmatch(ref.path, a.path) and a.found == ref.found),
                None,
            )
            if allow:
                allow.used = True
                finding = Finding("info", "allowed", finding.subject, f"{ref.found}: {allow.reason}")
            findings.append(finding)

    if whole_fleet:
        for a in allows:
            if not a.used:
                findings.append(Finding("warn", "allow-unused", f"{config}:{a.line}", f"allow {a.repo} {a.path} {a.found} matched nothing"))
    return report(findings, as_json)


def report(findings: list[Finding], as_json: bool) -> int:
    # The same reference reached twice (a compose anchor shared by several
    # services) is one finding.
    findings = list({(f.level, f.code, f.subject, f.message): f for f in findings}.values())
    if as_json:
        print(json.dumps([f.__dict__ for f in findings], indent=2))
    else:
        for f in findings:
            print(f)
    errors = sum(1 for f in findings if f.level == "error")
    allowed = sum(1 for f in findings if f.code == "allowed")
    print(f"images check: {errors} errors, {allowed} allowed", file=sys.stderr)
    return 1 if errors else 0


# -------------------------------------------------------------- sync, drift

VENDOR_DIR = ".github/images"
BANNER = "# Generated by dx images sync from dx/{src}. Do not edit; change dx and re-run sync."


def enrolled_repos(root_dir: str) -> list[str]:
    path = os.path.join(root_dir, "images-sync.config")
    with open(path) as f:
        return [line.split()[0] for line in f if line.strip() and not line.lstrip().startswith("#")]


def vendored_files(root_dir: str, config: str) -> dict[str, str]:
    """The files sync writes into a repo, keyed by repo-relative path."""
    with open(os.path.abspath(__file__)) as f:
        script = f.read()
    shebang, _, body = script.partition("\n")
    with open(config) as f:
        registry = f.read()
    return {
        f"{VENDOR_DIR}/images": f"{shebang}\n{BANNER.format(src='scripts/images')}\n{body}",
        f"{VENDOR_DIR}/images.config": f"{BANNER.format(src='images.config')}\n{registry}",
    }


def replace_token(line: str, old: str, new: str) -> str | None:
    """Replace `old` as a whole image token (not inside a longer reference)."""
    pattern = re.compile(r"(?<![\w./:@-])" + re.escape(old) + r"(?![\w./:@-])")
    out, n = pattern.subn(new, line, count=1)
    return out if n else None


def rewrite_values(chart_dir: str, found_name: str, found_tag: str, found_digest: str, entry: Ref) -> list[str]:
    """Point every pin of one image in a chart's values files at `entry`.

    Three forms are recognised: a repository/tag(/digest) map, a subchart tag
    field carrying tag@digest, and a full-reference override string.
    """
    changed = []
    name = normalize(found_name)
    old_pair = f"{found_tag}@{found_digest}" if found_digest else None
    old_full = f"{found_name}:{found_tag}" + (f"@{found_digest}" if found_digest else "")
    new_pair = f"{entry.tag}@{entry.digest}"
    for v in sorted(os.listdir(chart_dir)):
        if not (v == "values.yaml" or (v.startswith("values-") and v.endswith(".yaml"))):
            continue
        path = os.path.join(chart_dir, v)
        lines = (read_text(path) or "").split("\n")
        before = list(lines)

        # Map form: edit the tag line and set or insert the digest line.
        maps = subprocess.run(
            ["yq", "-o=json", "-I=0",
             '[.. | select(tag == "!!map" and (has("repository") or has("repo"))) | {"r": (.repository // .repo), "t": .tag, '
             '"rl": ((.repository // .repo) | line), "tl": (.tag | line), "dl": (.digest | line)}]', path],
            capture_output=True, text=True,
        )
        for m in json.loads(maps.stdout or "[]") if maps.returncode == 0 else []:
            if not isinstance(m.get("r"), str) or normalize(m["r"]) != name or str(m.get("t")) != found_tag or not m.get("tl"):
                continue
            t = m["tl"] - 1
            indent = lines[t][: len(lines[t]) - len(lines[t].lstrip())]
            lines[t] = f'{indent}tag: "{entry.tag}"'
            if m.get("dl"):
                lines[m["dl"] - 1] = f'{indent}digest: "{entry.digest}"'
            else:
                lines.insert(t + 1, f'{indent}digest: "{entry.digest}"')

        # String forms: tag@digest in a subchart tag field, or a full override.
        for i, line in enumerate(lines):
            if old_full and old_full in line and "@" in old_full:
                lines[i] = line.replace(old_full, entry_ref(found_name, entry))
            elif old_pair and old_pair in line:
                lines[i] = line.replace(old_pair, new_pair)

        if lines != before:
            with open(path, "w") as f:
                f.write("\n".join(lines))
            changed.append(path)
    return changed


def entry_ref(found_name: str, entry: Ref) -> str:
    """The registry entry spelled with the reference's own image name, so a
    docker.io/library/ prefix in a file survives the rewrite."""
    return f"{found_name}:{entry.tag}@{entry.digest}"


def sync_repo(name: str, root: str, config: str, root_dir: str) -> tuple[list[str], list[str]]:
    """Rewrite one repo's references to the registry and vendor the check.
    Returns (changed files, references that need a human)."""
    allows: list[Allow] = []
    entries_list, _ = parse_config(config, allows)
    entries = {(normalize(r.name), flavor(r.tag)): r for r in entries_list}
    names = {normalize(r.name) for r in entries_list}
    refs, findings = scan_repo(name, root, names)
    changed: set[str] = set()
    manual: list[str] = [str(f) for f in findings if f.level == "error"]

    for ref in refs:
        if ref.context == "unresolved":
            manual.append(f"{ref.path}:{ref.line}: {ref.found}: unresolved variable")
            continue
        m = IMAGE_RE.match(ref.found)
        if not m:
            continue
        found_name, tag, digest = m["name"], m["tag"] or "", m["digest"] or ""
        norm = normalize(found_name)
        if norm.startswith(FIRST_PARTY):
            continue
        if any(a.repo == name and fnmatch.fnmatch(ref.path, a.path) and a.found == ref.found for a in allows):
            continue
        entry = entries.get((norm, flavor(tag)))
        if entry is None:
            manual.append(f"{ref.path}: {ref.found}: no registry entry")
            continue
        if (tag, digest) == (entry.tag, entry.digest):
            continue

        if ref.context.startswith("rendered") or ref.context == "values pin":
            chart_dir = os.path.join(root, ref.path if ref.context.startswith("rendered") else os.path.dirname(ref.path))
            paths = rewrite_values(chart_dir, found_name, tag, digest, entry) if tag else []
            if paths:
                changed.update(os.path.relpath(p, root) for p in paths)
            else:
                manual.append(f"{ref.path} {ref.context}: {ref.found}: no values pin to rewrite; add one for {entry.raw}")
            continue

        path = os.path.join(root, ref.path)
        lines = (read_text(path) or "").split("\n")
        new = replace_token(lines[ref.line - 1], ref.found, entry_ref(found_name, entry)) if 0 < ref.line <= len(lines) else None
        if new is None:
            shown = lines[ref.line - 1].strip() if 0 < ref.line <= len(lines) else ""
            manual.append(f"{ref.path}:{ref.line}: {ref.found}: not a literal on `{shown}`; set it to {entry.raw}")
            continue
        lines[ref.line - 1] = new
        with open(path, "w") as f:
            f.write("\n".join(lines))
        changed.add(ref.path)

    for rel, content in vendored_files(root_dir, config).items():
        path = os.path.join(root, rel)
        if read_text(path) != content:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(content)
            if rel.endswith("/images"):
                os.chmod(path, 0o755)
            changed.add(rel)
    return sorted(changed), manual


def copy_tracked(src: str, dst: str) -> None:
    """Copy a repo's tracked files, plus vendored Helm chart dependencies, so a
    dry run sees what a sync would edit without node_modules or sockets."""
    files = repo_files(src)
    for d, _, names in os.walk(src):
        if os.path.basename(d) == "charts" and "/.git/" not in d + "/":
            files += [os.path.relpath(os.path.join(d, n), src) for n in names if n.endswith(".tgz")]
    for rel in files:
        s, t = os.path.join(src, rel), os.path.join(dst, rel)
        if os.path.isfile(s):
            os.makedirs(os.path.dirname(t), exist_ok=True)
            shutil.copy2(s, t)


def git(root: str, *args: str) -> str:
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, check=True).stdout.strip()


def integration_branch(root_dir: str, repo: str) -> str:
    with open(os.path.join(root_dir, "repos.json")) as f:
        ruleset = (json.load(f)["repos"].get(repo) or {}).get("ruleset") or ""
    return "development" if "development" in ruleset else "main"


def sync(argv: list[str]) -> int:
    root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    config = os.path.join(root_dir, "images.config")
    dry_run = no_pr = False
    targets: list[str] = []
    for a in argv:
        if a == "--dry-run":
            dry_run = True
        elif a == "--no-pr":
            no_pr = True
        elif a.startswith("--config="):
            config = a.split("=", 1)[1]
        elif a.startswith("-"):
            print(f"images: unknown flag: {a}", file=sys.stderr)
            return 2
        else:
            targets.append(a)
    workspace = os.environ.get("QUALITHM_ROOT") or os.path.dirname(root_dir)
    repos = targets or enrolled_repos(root_dir)
    failed = 0
    for repo in repos:
        root = repo if os.path.isdir(repo) and ("/" in repo or repo == ".") else os.path.join(workspace, repo)
        name = os.path.basename(os.path.abspath(root))
        if not os.path.isdir(root):
            print(f"images: {name}: repo not found at {root}", file=sys.stderr)
            failed = 1
            continue
        branch = base = ""
        if not (dry_run or no_pr):
            if git(root, "status", "--porcelain"):
                print(f"images: {name}: working tree not clean; skipped", file=sys.stderr)
                failed = 1
                continue
            base = integration_branch(root_dir, name)
            git(root, "fetch", "-q", "origin")
            git(root, "checkout", "-q", base)
            git(root, "merge", "-q", "--ff-only", f"origin/{base}")
            branch = "images-sync"
            git(root, "checkout", "-q", "-B", branch)
        if dry_run:
            # Work on a throwaway copy so a dry run never touches the repo.
            tmp = os.path.join(subprocess.run(["mktemp", "-d"], capture_output=True, text=True, check=True).stdout.strip(), name)
            copy_tracked(root, tmp)
            changed, manual = sync_repo(name, tmp, config, root_dir)
            shutil.rmtree(os.path.dirname(tmp))
        else:
            changed, manual = sync_repo(name, root, config, root_dir)
        for line in manual:
            print(f"manual\t{name}\t{line}")
        if not changed:
            print(f"  = {name}: in sync")
            if branch:
                git(root, "checkout", "-q", base)
                git(root, "branch", "-q", "-D", branch)
            continue
        print(f"  ~ {name}: {len(changed)} file(s){' would change' if dry_run else ''}: {', '.join(changed)}")
        if dry_run or no_pr:
            continue
        git(root, "add", "--", *changed)
        git(root, "commit", "-q", "-m", "chore(images): sync image pins from the dx registry")
        p = subprocess.run([os.path.join(root_dir, "dx"), "git", "feature", "--repo", root, "--base", base], capture_output=True, text=True)
        print("    " + (p.stdout.strip().splitlines() or [p.stderr.strip()])[-1])
        failed |= p.returncode != 0
    return failed


def drift(argv: list[str]) -> int:
    """Exit 1 when an enrolled repo's vendored registry or check is missing or
    stale, or a repo that references images is not enrolled."""
    root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    config = os.path.join(root_dir, "images.config")
    workspace = os.environ.get("QUALITHM_ROOT") or os.path.dirname(root_dir)
    enrolled = enrolled_repos(root_dir)
    targets = argv or enrolled
    want = vendored_files(root_dir, config)
    drifted = 0
    for repo in targets:
        root = os.path.join(workspace, repo)
        if repo not in enrolled:
            print(f"drift\t{repo}\tnot enrolled in images-sync.config")
            drifted += 1
            continue
        stale = [rel for rel, content in want.items() if read_text(os.path.join(root, rel)) != content]
        if stale:
            print(f"drift\t{repo}\t{', '.join(stale)} missing or stale; run dx images sync {repo}")
            drifted += 1
    if not argv:
        # A repo that names an image but is not enrolled has no gate at all.
        with open(os.path.join(root_dir, "repos.json")) as f:
            # dx is the registry's home, not a consumer: its test fixtures are
            # deliberately unpinned.
            others = sorted(set(json.load(f)["repos"]) - set(enrolled) - {"dx"})
        entries_list, _ = parse_config(config)
        names = {normalize(r.name) for r in entries_list}
        for repo in others:
            root = os.path.join(workspace, repo)
            if os.path.isdir(root) and scan_repo(repo, root, names)[0]:
                print(f"drift\t{repo}\treferences container images but is not enrolled in images-sync.config")
                drifted += 1
    print(f"images drift: {len(targets)} enrolled checked, {drifted} drifted", file=sys.stderr)
    return 1 if drifted else 0



def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = sys.argv[1], sys.argv[2:]
    if cmd == "verify":
        return verify(rest)
    if cmd == "pin":
        return pin(rest)
    if cmd == "check":
        return check(rest)
    if cmd == "sync":
        return sync(rest)
    if cmd == "drift":
        return drift(rest)
    print(f"images: unknown subcommand: {cmd} (use verify|pin|check|sync|drift)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
