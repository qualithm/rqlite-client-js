DOCKER_HUB = "registry-1.docker.io"

INDEX_TYPES = {
    "application/vnd.oci.image.index.v1+json",
    "application/vnd.docker.distribution.manifest.list.v2+json",
}
MANIFEST_TYPES = {
    "application/vnd.oci.image.manifest.v1+json",
    "application/vnd.docker.distribution.manifest.v2+json",
}
ACCEPT = ", ".join(sorted(INDEX_TYPES | MANIFEST_TYPES))

CODES = {
    "bad-line", "latest", "duplicate-flavor", "digest-missing", "not-index", "no-amd64",
    "tag-missing", "tag-moves", "unreachable", "no-arm64", "tag-rebuilt",
}

NAME = r"(?P<name>[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)*)"
TAG = r"(?P<tag>[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})"
PINNED_RE = re.compile(rf"^{NAME}:{TAG}@(?P<digest>sha256:[0-9a-f]{{64}})$")
TAGGED_RE = re.compile(rf"^{NAME}:{TAG}$")
WAIVER_RE = re.compile(r"^waive=(?P<codes>[a-z0-9,-]+)$")
ISSUE_RE = re.compile(r"^issue=(?P<issue>[\w.-]+/[\w.-]+#\d+)$")
# A comment is a `#` at line start or after whitespace and followed by
# whitespace or end of line, so `issue=qualithm/pm#1052` is not one.
COMMENT_RE = re.compile(r"(?:^|\s)#(?:\s.*)?$")


@dataclass
class Ref:
    """One image reference, split into the parts registries address."""

    name: str
    tag: str
    digest: str = ""
    line: int = 0
    waived: frozenset[str] = frozenset()

    @property
    def raw(self) -> str:
        return f"{self.name}:{self.tag}" + (f"@{self.digest}" if self.digest else "")

    @property
    def host(self) -> str:
        first = self.name.split("/", 1)[0]
        if "/" in self.name and ("." in first or ":" in first or first == "localhost"):
            return first
        return DOCKER_HUB

    @property
    def path(self) -> str:
        if self.host != DOCKER_HUB:
            return self.name.split("/", 1)[1]
        return self.name if "/" in self.name else f"library/{self.name}"


@dataclass
class Finding:
    level: str  # error | warn
    code: str
    subject: str
    message: str
    waived: bool = False

    def __str__(self) -> str:
        level = "waived" if self.waived else self.level
        return f"{level}\t{self.code}\t{self.subject}\t{self.message}"


def flavor(tag: str) -> str:
    """The tag with every version or date segment removed, along with its
    separator, so 1.98-alpine3.24 and 1.98.1-alpine3.24, or trixie-slim and
    trixie-20260918-slim, are one flavor while 1.3.14 and 1.3.14-distroless are
    not. Two registry entries may not share an image and a flavor, and a
    reference is held to the entry of its flavor."""
    return re.sub(r"[.-]?v?\d+", "", tag)


def refining_pattern(tag: str) -> re.Pattern[str]:
    """Match tags that add version detail to `tag` and nothing else.

    Detail is one or more `.N` or `-N` segments inserted after a numeric run or
    before a `-`: 2.15-scratch -> 2.15.0-scratch, 3.24 -> 3.24.2,
    trixie-slim -> trixie-20260918-slim, 1.98-alpine3.24 -> 1.98.1-alpine3.24.
    """
    extra = r"(?:[.-]\d+)+"
    out = []
    i = 0
    for m in re.finditer(r"\d+(?:\.\d+)*|-", tag):
        out.append(re.escape(tag[i : m.start()]))
        if m.group() == "-":
            out.append(f"(?:{extra}(?=-))?-")
        else:
            out.append(re.escape(m.group()) + f"(?:{extra})?")
        i = m.end()
    out.append(re.escape(tag[i:]))
    return re.compile("^" + "".join(out) + "$")


@dataclass
class Allow:
    """A reference that may differ from the registry, with the reason why."""

    repo: str
    path: str
    found: str
    reason: str
    line: int
    used: bool = False


def parse_config(path: str, allows: list[Allow] | None = None) -> tuple[list[Ref], list[Finding]]:
    refs: list[Ref] = []
    findings: list[Finding] = []
    with open(path) as f:
        for n, line in enumerate(f, 1):
            fields = COMMENT_RE.sub("", line.rstrip("\n")).split()
            if not fields:
                continue
            where = f"{path}:{n}"
            if fields[0] == "allow":
                if len(fields) < 5:
                    findings.append(Finding("error", "bad-line", where, "allow needs <repo> <path-glob> <reference> <reason>"))
                elif allows is not None:
                    allows.append(Allow(fields[1], fields[2], fields[3], " ".join(fields[4:]), n))
                continue
            m = PINNED_RE.match(fields[0])
            if not m:
                findings.append(Finding("error", "bad-line", where, f"not <repo>:<tag>@sha256:<digest>: {fields[0]}"))
                continue
            waived: set[str] = set()
            issue = ""
            bad = ""
            for extra in fields[1:]:
                if w := WAIVER_RE.match(extra):
                    waived |= set(w["codes"].split(","))
                elif i := ISSUE_RE.match(extra):
                    issue = i["issue"]
                else:
                    bad = f"unexpected field {extra!r}"
            unknown = waived - CODES
            if not bad and unknown:
                bad = f"unknown waiver code(s) {', '.join(sorted(unknown))}"
            elif not bad and waived and not issue:
                bad = "a waiver needs issue=<owner>/<repo>#<n> naming the issue that removes it"
            elif not bad and issue and not waived:
                bad = "issue= without waive="
            if bad:
                findings.append(Finding("error", "bad-line", where, bad))
                continue
            refs.append(Ref(m["name"], m["tag"], m["digest"], n, frozenset(waived)))
    return refs, findings


def offline_checks(refs: list[Ref], path: str) -> list[Finding]:
    out = []
    seen: dict[tuple[str, str], Ref] = {}
    for r in refs:
        if r.tag == "latest":
            out.append(Finding("error", "latest", r.raw, "`latest` is not a version; pin the exact tag"))
        key = (r.name, flavor(r.tag))
        if key in seen:
            prior = seen[key]
            out.append(
                Finding(
                    "error",
                    "duplicate-flavor",
                    r.raw,
                    f"same image flavor as {prior.raw} ({path}:{prior.line}); one pin per flavor",
                )
            )
        else:
            seen[key] = r
    return out


@dataclass
class Client:
    """Minimal anonymous registry v2 client with per-repository token caching."""

    tokens: dict[tuple[str, str], str] = field(default_factory=dict)

    def _url(self, host: str, path: str) -> str:
        scheme = "http" if host.split(":")[0] in ("localhost", "127.0.0.1") else "https"
        return f"{scheme}://{host}{path}"

    def _token(self, host: str, repo: str, challenge: str) -> str:
        params = dict(re.findall(r'(\w+)="([^"]*)"', challenge))
        realm = params.pop("realm", "")
        if not realm:
            raise RuntimeError(f"{host}: unsupported auth challenge: {challenge}")
        params.setdefault("scope", f"repository:{repo}:pull")
        req = urllib.request.Request(realm + "?" + urllib.parse.urlencode(params))
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = json.load(resp)
        return body.get("token") or body.get("access_token") or ""

    def request(self, method: str, host: str, repo: str, path: str) -> tuple[int, dict[str, str], bytes]:
        url = self._url(host, path)
        for attempt in range(2):
            req = urllib.request.Request(url, method=method)
            req.add_header("Accept", ACCEPT)
            token = self.tokens.get((host, repo))
            if token:
                req.add_header("Authorization", f"Bearer {token}")
            try:
                with urllib.request.urlopen(req, timeout=30) as resp:
                    return resp.status, {k.lower(): v for k, v in resp.headers.items()}, resp.read()
            except urllib.error.HTTPError as e:
                challenge = e.headers.get("WWW-Authenticate", "")
                if e.code == 401 and attempt == 0 and challenge.lower().startswith("bearer"):
                    self.tokens[(host, repo)] = self._token(host, repo, challenge)
                    continue
                return e.code, {k.lower(): v for k, v in e.headers.items()}, b""
        raise RuntimeError("unreachable")

    def head_digest(self, host: str, repo: str, reference: str) -> str | None:
        status, headers, _ = self.request("HEAD", host, repo, f"/v2/{repo}/manifests/{reference}")
        if status != 200:
            return None
        return headers.get("docker-content-digest")

    def manifest(self, host: str, repo: str, reference: str) -> tuple[int, dict]:
        status, headers, body = self.request("GET", host, repo, f"/v2/{repo}/manifests/{reference}")
        if status != 200:
            return status, {}
        doc = json.loads(body)
        doc.setdefault("mediaType", headers.get("content-type", "").split(";")[0])
        return status, doc

    def tags(self, host: str, repo: str) -> list[str]:
        out: list[str] = []
        path: str | None = f"/v2/{repo}/tags/list?n=1000"
        while path:
            status, headers, body = self.request("GET", host, repo, path)
            if status != 200:
                break
            out.extend(json.loads(body).get("tags") or [])
            m = re.search(r'<([^>]+)>;\s*rel="?next"?', headers.get("link", ""))
            path = None
            if m:
                nxt = urllib.parse.urlsplit(m.group(1))
                path = nxt.path + ("?" + nxt.query if nxt.query else "")
        return out


def most_specific(client: Client, r: Ref, digests: set[str]) -> str | None:
    """The most specific tag refining r.tag whose digest is in `digests`."""
    pattern = refining_pattern(r.tag)
    candidates = sorted(
        (t for t in client.tags(r.host, r.path) if t != r.tag and pattern.match(t)),
        key=lambda t: (-len(re.findall(r"\d+", t)), t),
    )
    for t in candidates:
        if client.head_digest(r.host, r.path, t) in digests:
            return t
    return None


def _is_attestation_entry(m: dict) -> bool:
    annotations = m.get("annotations") or {}
    platform = m.get("platform") or {}
    return annotations.get("vnd.docker.reference.type") == "attestation-manifest" or platform.get("os") == "unknown"


def _is_attestation(doc: dict) -> bool:
    return any("in-toto" in (layer.get("mediaType") or "") for layer in doc.get("layers") or [])


def online_checks(client: Client, r: Ref) -> list[Finding]:
    status, doc = client.manifest(r.host, r.path, r.digest)
    if status == 404:
        return [Finding("error", "digest-missing", r.raw, f"digest not found in {r.host}/{r.path}")]
    if status != 200:
        return [Finding("error", "unreachable", r.raw, f"registry returned HTTP {status} for the digest")]

    current = client.head_digest(r.host, r.path, r.tag)
    if doc.get("mediaType") not in INDEX_TYPES:
        kind = "an attestation" if _is_attestation(doc) else "a single-platform"
        hint = f"; the tag's index is {current}" if current else ""
        return [Finding("error", "not-index", r.raw, f"digest is {kind} manifest, not a multi-arch index{hint}")]

    out = []
    platforms = {
        f"{p.get('os')}/{p.get('architecture')}"
        for m in doc.get("manifests", [])
        if (p := m.get("platform")) and not _is_attestation_entry(m)
    }
    if "linux/amd64" not in platforms:
        found = ", ".join(sorted(platforms)) or "none"
        out.append(Finding("error", "no-amd64", r.raw, f"index has no linux/amd64 image ({found})"))
    if "linux/arm64" not in platforms:
        out.append(Finding("warn", "no-arm64", r.raw, "index has no linux/arm64 image"))

    if current is None:
        out.append(Finding("error", "tag-missing", r.raw, f"tag {r.tag} no longer exists"))
    elif current != r.digest:
        out.append(Finding("warn", "tag-rebuilt", r.raw, f"tag now points at {current}"))

    better = most_specific(client, r, {r.digest} | ({current} if current else set()))
    if better:
        out.append(Finding("error", "tag-moves", r.raw, f"{better} is the same image; pin that tag instead"))
    return out


def verify(argv: list[str]) -> int:
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    config = os.path.join(root, "images.config")
    offline = False
    only: list[str] = []
    it = iter(argv)
    for a in it:
        if a == "--config":
            config = next(it, "")
        elif a.startswith("--config="):
            config = a.split("=", 1)[1]
        elif a == "--offline":
            offline = True
        elif a.startswith("-"):
            print(f"images: unknown flag: {a}", file=sys.stderr)
            return 2
        else:
            only.append(a)
    if not os.path.isfile(config):
        print(f"images: registry not found: {config}", file=sys.stderr)
        return 2

    refs, findings = parse_config(config)
    findings += offline_checks(refs, config)
    if not offline:
        targets = [r for r in refs if not only or r.raw in only or r.name in only]
        client = Client()

        def check(r: Ref) -> list[Finding]:
            try:
                return online_checks(client, r)
            except (urllib.error.URLError, RuntimeError, TimeoutError, ValueError) as e:
                return [Finding("error", "unreachable", r.raw, f"registry unreachable: {e}")]

        # Tag listings of large Docker Hub repositories dominate the run time.
        with ThreadPoolExecutor(max_workers=8) as pool:
            for result in pool.map(check, targets):
                findings += result

    waivers = {r.raw: r.waived for r in refs}
    for f in findings:
        f.waived = f.code in waivers.get(f.subject, frozenset())
        print(f)
    errors = sum(1 for f in findings if f.level == "error" and not f.waived)
    warns = sum(1 for f in findings if f.level == "warn" and not f.waived)
    waived = sum(1 for f in findings if f.waived)
    print(f"images verify: {len(refs)} entries, {errors} errors, {warns} warnings, {waived} waived", file=sys.stderr)
    return 1 if errors else 0


def pin(argv: list[str]) -> int:
    if not argv:
        print("images: pin needs at least one <repo>:<tag>", file=sys.stderr)
        return 2
    client = Client()

    def resolve(arg: str) -> tuple[str, str]:
        """Return (registry line, error); exactly one is non-empty."""
        m = TAGGED_RE.match(arg)
        if not m:
            return "", f"not <repo>:<tag>: {arg}"
        r = Ref(m["name"], m["tag"])
        digest = client.head_digest(r.host, r.path, r.tag)
        if not digest:
            return "", f"tag not found: {arg}"
        status, doc = client.manifest(r.host, r.path, digest)
        if doc.get("mediaType") not in INDEX_TYPES:
            return "", f"{arg} is not a multi-arch index ({doc.get('mediaType') or status})"
        tag = most_specific(client, r, {digest}) or r.tag
        return f"{r.name}:{tag}@{digest}", ""

    failed = 0
    with ThreadPoolExecutor(max_workers=8) as pool:
        for line, err in pool.map(resolve, argv):
            if err:
                print(f"images: {err}", file=sys.stderr)
                failed = 1
            else:
                print(line)
    return failed

