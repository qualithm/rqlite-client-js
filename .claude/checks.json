{
  "version": 1,
  "commands": [
    {
      "run": "bun run lint",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "bun run format",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "bun run typecheck",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "python3 .claude/checks/ci-jobs.py --skip-ci-only coverage",
      "timeout": "30m",
      "dir": "."
    }
  ]
}
